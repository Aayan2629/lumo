# Copy to lumo/.env and fill in. lumo/.env is git-ignored.
# LLM (provider decided on hackathon day; see to-do.md)
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=
# Data sources
# test = free sandbox (Bondi, Belmont North). A hackathon key (ht26_...) uses api-ht.microburbs.com.au
# and covers the City of Sydney's 29 suburbs; outside them Lumo falls back to the sandbox.
MICROBURBS_KEY=test
# Optional: force a host, e.g. https://api-ht.microburbs.com.au
MICROBURBS_BASE=
GOOGLE_MAPS_KEY=
TFNSW_KEY=
MAPILLARY_TOKEN=
