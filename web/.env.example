# Copy to web/.env.local. Never commit real values: in production these live in the host's
# secrets manager (Cloudflare / Vercel / Fly secrets), not in the repo or the app bundle.
DATABASE_URL=postgres://lumo:lumo-dev@localhost:5432/lumo_dev
APP_URL=http://localhost:3000
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Lets the pilot run on mock providers. Leave unset in production so mocks are refused.
LUMO_ALLOW_MOCKS=1

# Microburbs: sample (offline, labelled "sample data") or live
MICROBURBS_PROVIDER=sample
MICROBURBS_KEY=
MICROBURBS_BASE=

# Identity (DVS gateway) and open banking: mock until contracts are in place
ID_PROVIDER=mock
BANK_PROVIDER=mock
ID_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
FINANCE_WEBHOOK_SECRET=

# NSW licence register: mock or nsw
LICENCE_PROVIDER=mock

# Email: outbox (shown at /dev/outbox) or resend
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=Lumo <match@mail.example.com>

# Billing: mock or stripe
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLAN=
STRIPE_PRICE_BOOST=

# Cloudflare Turnstile. Without a secret, only the dev token passes (and only with mocks on).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Protects /api/cron/* (call with Authorization: Bearer <value>)
CRON_SECRET=
